# Days to Decay Environment Configuration
APP_NAME="DAYS TO DECAY"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Model & Artifacts
MODEL_CHECKPOINT_PATH=artifacts/best_model.pth
MODEL_METADATA_PATH=artifacts/model_metadata.json
DEVICE=cpu

# Conformal Prediction Calibration
CALIBRATION_FILE=artifacts/calibration_residuals.json
CONFIDENCE_LEVEL=0.90

# Upload limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

