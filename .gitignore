# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Data & Models (large binary files)
data/raw/*
!data/raw/.gitkeep
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/processed/*/*
!data/processed/*/.gitkeep
artifacts/checkpoints/*.pth
!artifacts/checkpoints/.gitkeep
artifacts/*.pth

# OS generated files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Test & coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & temp
*.log
tmp/
